# Postgres warehouse connection behind your Sigma connection.
# Must be reachable both directly (for run_sql.sh / validate_personas.py) and
# via the Sigma connection whose id you put in config.json — same warehouse,
# two paths in.

export PGHOST='REPLACE_WITH_YOUR_PG_HOST'
export PGUSER='REPLACE_WITH_YOUR_PG_USER'
export PGPORT='5432'
export PGDATABASE='REPLACE_WITH_YOUR_PG_DATABASE'
export PGSSLMODE='require'

export PGPASSWORD='REPLACE_WITH_YOUR_PG_PASSWORD'

# Target schema for the RLS example objects — must match config.json's "schema".
export RLS_SCHEMA='REPLACE_WITH_YOUR_SCHEMA'
